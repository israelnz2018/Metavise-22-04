# Dependencies
node_modules/

# Build output
build/
dist/
coverage/

# Environment & secrets
.env*
!.env.example
# Per-provider API key files written by the in-app admin "Salvar" buttons.
# firebase-applet-config.json is intentionally NOT ignored (public web config).
elevenlabs-config.json
heygen-config.json
runway-config.json
gemini-config.json
assemblyai-config.json
zapcap-config.json
claude-config.json

# Firestore doc backups (contain production user data — never commit).
backup-*.json

# Runtime output: videos/audios generated by the user. These are user data,
# never source code, and can hit hundreds of MB. Always ignore.
generated/

# Logs & debug artifacts
*.log
debug*.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
# …but DO check in workspace-shared settings + recommended extensions
# so the whole team gets identical format-on-save + the same prompt
# to install Prettier/ESLint/Tailwind tooling.
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Local Claude Code config (preview tool launch.json, etc.)
.claude/

# Temp files
*.tmp
*.bak

# Test/coverage caches
.vitest/
.nyc_output/

# Playwright artefacts: HTML reports, traces, screenshots, videos.
# Browser binaries land in ~/Library/Caches/ms-playwright (out of repo).
playwright-report/
test-results/
playwright/.cache/

# Lighthouse CI local report output
.lighthouseci/

# TypeScript build info
*.tsbuildinfo

# ytdl-core debug dumps (emitted on player parse failures)
*-player-script.js

# Background cache (generated at runtime by intercut feature)
server/assets/bg-cache/

# Chave de service account do Firebase (NUNCA commitar)
service-account.json

# Medidor de gasto da API Claude (runtime)
claude-usage.json
pexels-config.json

# arquivo acidental (env do cloud run)
/-

rules_version = '2';

// Reads require auth so generated videos/audios are not publicly enumerable
// by anyone who guesses (or scrapes) a bucket URL. Writes already require
// auth. Backend code that needs to expose a file to an unauthenticated
// client must use signed URLs (server/routes/*.routes.ts already does this
// via bucket.file(...).getSignedUrl) — signed URLs include their own
// short-lived auth token and bypass these rules entirely.
service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /video/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /audio/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /projects/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}

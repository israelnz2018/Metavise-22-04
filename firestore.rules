rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "israelnz2018@hotmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'credits']) &&
             data.uid is string &&
             data.credits is number &&
             data.credits >= 0;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users can only create their own profile with default credits, or admin can create
      allow create: if isAuthenticated() &&
                    ((isOwner(userId) && request.resource.data.credits == 1000 && request.resource.data.role == 'user') || isAdmin());
      // Users can't update their own credits directly (must be via server/admin)
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.credits == resource.data.credits);

      // UX18/UX20: biblioteca pessoal de copies. User tem CRUD total da
      // própria sub-collection. Admin também pode ler/escrever pra suporte.
      match /copyLibrary/{copyId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Biblioteca pessoal de músicas (opt-in). Mesmo modelo da copyLibrary:
      // o dono tem CRUD total; admin lê/escreve pra suporte.
      match /musicLibrary/{musicId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Biblioteca pessoal de enquadramentos de avatar (opt-in). Mesmo modelo.
      match /framingLibrary/{framingId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Subprojetos (variants) moram nesta subcoleção desde a migração que tirou
      // o array `variants[]` de dentro do doc do projeto (limite de 1 MiB). As
      // regras NÃO são herdadas pelo filho — sem esta, o app não consegue ler
      // nem gravar subprojetos. Dono = dono do projeto pai.
      match /variants/{variantId} {
        allow read, write: if isAuthenticated() &&
          (get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid
           || isAdmin());
      }
    }

    match /usage_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false; // Only server-side or admin should create logs
    }
  }
}
